# ── App ──────────────────────────────────────────────
PORT=10000
NODE_ENV=production
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=https://preventiva-radicacion.onrender.com,http://localhost:5173
# true = no envía correo, solo simula (útil para probar)
DRY_RUN=false
MAX_TOTAL_MB=20

# ── SMTP (Gmail) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
# Contraseña de aplicación de Google (16 caracteres), NUNCA la clave normal
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Radicación Preventiva IPS" <tu-cuenta@gmail.com>
MAIL_TO=destino@preventivaips.com.co

# ── Flags ────────────────────────────────────────────
USE_RESEND=false
